# Copy to .env and fill in. NEVER commit the real .env.
#
# This file feeds the Docker Compose stack. For hand-run processes outside a
# container, backend/.env.example and frontend/.env.local apply instead.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Dev default is css123 (matches docker-compose.yml's fallback). PRODUCTION
# REQUIRES this to be set — docker-compose.prod.yml turns it into a hard
# failure rather than letting the dev value reach a real server.
#   openssl rand -hex 32
POSTGRES_PASSWORD=css123

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------
# The production site is a SINGLE hostname: creativesoundstudio.rw. The browser
# calls /api on that same origin and Next.js rewrites it to the backend, so
# there is no api. subdomain and no CORS handshake in practice.
#
# APP_URL          tracking links (/track/<token>) + the login-email sub-link
# FRONTEND_URL     magic-link dashboard URLs (/login?token=…)
# FRONTEND_ORIGIN  the CORS allowlist (defence in depth; same-origin is primary)
# API_URL          declared API origin, informational
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# Canonical origin for metadataBase, sitemap.xml, robots.txt and OG URLs.
# Build-time only: changing it requires a frontend rebuild.
NEXT_PUBLIC_SITE_URL=https://creativesoundstudio.rw

# Normally leave EMPTY. The browser uses same-origin /api paths, which keeps the
# image host-agnostic (no rebuild when the domain changes). Set it only for a dev
# setup that should call the API cross-origin, e.g. http://localhost:4000.
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
# openssl rand -hex 32 — must be >= 32 chars or the backend refuses to start
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_EMAILS=

# How long a client magic-link stays valid (hours)
MAGIC_LINK_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# MAIL_FROM may only use hello@creativesoundstudio.rw once the Resend sending
# domain is verified — otherwise the provider rejects it and every magic link
# silently fails to arrive. Until then keep onboarding@resend.dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creative Sound Studio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Zavu (WhatsApp) — https://zavu.dev
# ---------------------------------------------------------------------------
ZAVU_API_KEY=
ZAVU_SENDER=

# ---------------------------------------------------------------------------
# Production image selection (docker-compose.prod.yml only)
# ---------------------------------------------------------------------------
# GHCR_OWNER=mutijima-bertin
# IMAGE_TAG=main