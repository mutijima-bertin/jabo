# Used by hand-run backend processes (tsx, vitest). The Docker Compose stack
# reads the ROOT .env instead — see /.env.example.
#
# Copy to .env and fill in. NEVER commit the real .env.

# Database (the compose postgres service, published on 127.0.0.1:5432 by
# docker-compose.override.yml for local dev only)
DATABASE_URL="postgresql://css:css123@localhost:5432/creativesoundstudio?schema=public"

# Zavu (WhatsApp) - get at https://zavu.dev
ZAVU_API_KEY=""

# SMTP (Nodemailer)
# Resend free (recommended): host=smtp.resend.com, port=465, secure=true,
# user=resend, pass=<API key re_... from resend.com/beta/api-keys>.
# Until the sending domain is verified, MAIL_FROM must stay
# "Name <onboarding@resend.dev>".
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Creative Sound Studio <onboarding@resend.dev>"

# Admin notification emails (comma separated)
ADMIN_EMAILS=""

# App URLs
#   APP_URL          tracking links (/track/<token>) + login-email sub-link
#   FRONTEND_URL     magic-link dashboard URLs (/login?token=…)
#   FRONTEND_ORIGIN  CORS allowlist (defence in depth)
#   API_URL          declared API origin
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"
API_URL="http://localhost:4000"
MAGIC_LINK_TTL_HOURS=168

# Auth (generate: openssl rand -hex 32)
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ZAVU_SENDER=""