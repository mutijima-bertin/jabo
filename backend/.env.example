# SMTP (Nodemailer)
# Resend free (recommended): host=smtp.resend.com, port=465, secure=true,
# user=resend, pass=<API key re_... from resend.com/beta/api-keys>.
# Until a domain is verified, MAIL_FROM must be "Name <onboarding@resend.dev>".
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Creative Sound Studio <hello@creativesoundstudio.rw>"

# Admin notification emails (comma separated)
